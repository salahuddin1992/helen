# Normalize line endings for text; let git auto-detect text vs binary.
* text=auto

# ── Git-LFS scope ─────────────────────────────────────────────────────────
# IMPORTANT: this repo's history committed source files AND native binaries
# (*.so, *.ico, *.exe, ...) as ordinary git blobs, while only bulk *data*
# artifacts were stored as LFS pointers. The original catch-all
# `* filter=lfs` therefore disagreed with what was actually committed and
# made hundreds of unchanged files (source + .so) show as "modified" on a
# clean checkout. LFS is now scoped to exactly the data/binary extensions
# that are genuine LFS pointers in history, so the working tree matches HEAD.
*.db        filter=lfs diff=lfs merge=lfs -text
*.db-shm    filter=lfs diff=lfs merge=lfs -text
*.db-wal    filter=lfs diff=lfs merge=lfs -text
*.sqlite    filter=lfs diff=lfs merge=lfs -text
*.sqlite-shm filter=lfs diff=lfs merge=lfs -text
*.sqlite-wal filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.bin       filter=lfs diff=lfs merge=lfs -text

# Config files git must never touch with text/eol filters.
.gitattributes -filter -diff -merge text
.gitignore -filter -diff -merge text
**/.gitignore -filter -diff -merge text
